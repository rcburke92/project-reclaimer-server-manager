  "rules": [
    {
      "key": "score_to_win",
      "label": "Score to win",
      "group": "Scoring",
      "type": "int",
      "min": 0,
      "max": 999,
      "default": 25,
      "help": "Points that win a round. 0 = no limit (the time limit ends the round)."
    },
    {
      "key": "kill_points",
      "label": "Kill points",
      "group": "Scoring",
      "type": "int",
      "min": -10,
      "max": 10,
      "default": 1,
      "help": "Points for a kill, on top of any a script gives."
    },
    {
      "key": "death_points",
      "label": "Death points",
      "group": "Scoring",
      "type": "int",
      "min": -10,
      "max": 10,
      "default": 0,
      "help": "Points for dying, usually 0 or negative."
    },
    {
      "key": "suicide_points",
      "label": "Suicide points",
      "group": "Scoring",
      "type": "int",
      "min": -10,
      "max": 10,
      "default": -1,
      "help": "Points for killing yourself, usually 0 or negative."
    },
    {
      "key": "betrayal_points",
      "label": "Betrayal points",
      "group": "Scoring",
      "type": "int",
      "min": -10,
      "max": 10,
      "default": -1,
      "help": "Points for killing a teammate, usually 0 or negative."
    }
  ],
